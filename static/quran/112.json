{"surah":112,"verses":[{"n":1,"key":"112:1","arabic":"قُلۡ هُوَ ٱللَّهُ أَحَدٌ","page":604,"juz":30,"en":"Say, \"He is Allāh, [who is] One,","id":"Katakanlah (Muhammad), \"Dialah Allah, Yang Maha Esa.","words":[{"a":"قُلۡ","en":"Say","id":"Say"},{"a":"هُوَ","en":"He","id":"He"},{"a":"ٱللَّهُ","en":"(is) Allah","id":"(is) Allah"},{"a":"أَحَدٌ","en":"the One","id":"the One"}]},{"n":2,"key":"112:2","arabic":"ٱللَّهُ ٱلصَّمَدُ","page":604,"juz":30,"en":"Allāh, the Eternal Refuge.","id":"Allah tempat meminta segala sesuatu.","words":[{"a":"ٱللَّهُ","en":"Allah","id":"Allah"},{"a":"ٱلصَّمَدُ","en":"the Eternal, the Absolute","id":"the Eternal, the Absolute"}]},{"n":3,"key":"112:3","arabic":"لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ","page":604,"juz":30,"en":"He neither begets nor is born,","id":"(Allah) tidak beranak dan tidak pula diperanakkan.","words":[{"a":"لَمۡ","en":"Not","id":"Not"},{"a":"يَلِدۡ","en":"He begets","id":"He begets"},{"a":"وَلَمۡ","en":"and not","id":"and not"},{"a":"يُولَدۡ","en":"He is begotten","id":"He is begotten"}]},{"n":4,"key":"112:4","arabic":"وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ","page":604,"juz":30,"en":"Nor is there to Him any equivalent.\"","id":"Dan tidak ada sesuatu yang setara dengan Dia.\"","words":[{"a":"وَلَمۡ","en":"And not","id":"And not"},{"a":"يَكُن","en":"is","id":"is"},{"a":"لَّهُۥ","en":"for Him","id":"for Him"},{"a":"كُفُوًا","en":"equivalent","id":"equivalent"},{"a":"أَحَدُۢ","en":"any [one]","id":"any [one]"}]}]}
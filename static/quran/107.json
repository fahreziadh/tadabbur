{"surah":107,"verses":[{"n":1,"key":"107:1","arabic":"أَرَءَيۡتَ ٱلَّذِي يُكَذِّبُ بِٱلدِّينِ","page":602,"juz":30,"en":"Have you seen the one who denies the Recompense?","id":"Tahukah kamu (orang) yang mendustakan agama?","words":[{"a":"أَرَءَيۡتَ","en":"Have you seen","id":"Have you seen"},{"a":"ٱلَّذِي","en":"the one who","id":"the one who"},{"a":"يُكَذِّبُ","en":"denies","id":"denies"},{"a":"بِٱلدِّينِ","en":"the Judgment","id":"the Judgment"}]},{"n":2,"key":"107:2","arabic":"فَذَٰلِكَ ٱلَّذِي يَدُعُّ ٱلۡيَتِيمَ","page":602,"juz":30,"en":"For that is the one who drives away the orphan","id":"Maka itulah orang yang menghardik anak yatim,","words":[{"a":"فَذَٰلِكَ","en":"Then that","id":"Then that"},{"a":"ٱلَّذِي","en":"(is) the one who","id":"(is) the one who"},{"a":"يَدُعُّ","en":"repulses","id":"repulses"},{"a":"ٱلۡيَتِيمَ","en":"the orphan","id":"the orphan"}]},{"n":3,"key":"107:3","arabic":"وَلَا يَحُضُّ عَلَىٰ طَعَامِ ٱلۡمِسۡكِينِ","page":602,"juz":30,"en":"And does not encourage the feeding of the poor.","id":"dan tidak mengajak memberi makan orang miskin.","words":[{"a":"وَلَا","en":"And (does) not","id":"And (does) not"},{"a":"يَحُضُّ","en":"feel the urge","id":"feel the urge"},{"a":"عَلَىٰ","en":"to","id":"to"},{"a":"طَعَامِ","en":"feed","id":"feed"},{"a":"ٱلۡمِسۡكِينِ","en":"the poor","id":"the poor"}]},{"n":4,"key":"107:4","arabic":"فَوَيۡلٞ لِّلۡمُصَلِّينَ","page":602,"juz":30,"en":"So woe to those who pray","id":"Maka celakalah orang yang salat,","words":[{"a":"فَوَيۡلٞ","en":"So woe","id":"So woe"},{"a":"لِّلۡمُصَلِّينَ","en":"to those who pray","id":"to those who pray"}]},{"n":5,"key":"107:5","arabic":"ٱلَّذِينَ هُمۡ عَن صَلَاتِهِمۡ سَاهُونَ","page":602,"juz":30,"en":"[But] who are heedless of their prayer -","id":"(yaitu) orang-orang yang lalai terhadap salatnya,","words":[{"a":"ٱلَّذِينَ","en":"Those who","id":"Those who"},{"a":"هُمۡ","en":"[they]","id":"[they]"},{"a":"عَن","en":"about","id":"about"},{"a":"صَلَاتِهِمۡ","en":"their prayers","id":"their prayers"},{"a":"سَاهُونَ","en":"(are) neglectful","id":"(are) neglectful"}]},{"n":6,"key":"107:6","arabic":"ٱلَّذِينَ هُمۡ يُرَآءُونَ","page":602,"juz":30,"en":"Those who make show [of their deeds]","id":"yang berbuat riya`,","words":[{"a":"ٱلَّذِينَ","en":"Those who","id":"Those who"},{"a":"هُمۡ","en":"[they]","id":"[they]"},{"a":"يُرَآءُونَ","en":"make show","id":"make show"}]},{"n":7,"key":"107:7","arabic":"وَيَمۡنَعُونَ ٱلۡمَاعُونَ","page":602,"juz":30,"en":"And withhold [simple] assistance.","id":"dan enggan (memberikan) bantuan.","words":[{"a":"وَيَمۡنَعُونَ","en":"And they deny","id":"And they deny"},{"a":"ٱلۡمَاعُونَ","en":"[the] small kindnesses","id":"[the] small kindnesses"}]}]}
{"surah":87,"verses":[{"n":1,"key":"87:1","arabic":"سَبِّحِ ٱسۡمَ رَبِّكَ ٱلۡأَعۡلَى","page":591,"juz":30,"en":"Exalt the name of your Lord, the Most High,","id":"Sucikanlah nama Tuhanmu Yang Mahatinggi,","words":[{"a":"سَبِّحِ","en":"Glorify","id":"Glorify"},{"a":"ٱسۡمَ","en":"(the) name","id":"(the) name"},{"a":"رَبِّكَ","en":"(of) your Lord","id":"(of) your Lord"},{"a":"ٱلۡأَعۡلَى","en":"the Most High","id":"the Most High"}]},{"n":2,"key":"87:2","arabic":"ٱلَّذِي خَلَقَ فَسَوَّىٰ","page":591,"juz":30,"en":"Who created and proportioned","id":"yang menciptakan, lalu menyempurnakan (penciptaan-Nya),","words":[{"a":"ٱلَّذِي","en":"The One Who","id":"The One Who"},{"a":"خَلَقَ","en":"created","id":"created"},{"a":"فَسَوَّىٰ","en":"then proportioned","id":"then proportioned"}]},{"n":3,"key":"87:3","arabic":"وَٱلَّذِي قَدَّرَ فَهَدَىٰ","page":591,"juz":30,"en":"And who destined and [then] guided","id":"yang menentukan kadar (masing-masing) dan memberi petunjuk,","words":[{"a":"وَٱلَّذِي","en":"And the One Who","id":"And the One Who"},{"a":"قَدَّرَ","en":"measured","id":"measured"},{"a":"فَهَدَىٰ","en":"then guided","id":"then guided"}]},{"n":4,"key":"87:4","arabic":"وَٱلَّذِيٓ أَخۡرَجَ ٱلۡمَرۡعَىٰ","page":591,"juz":30,"en":"And who brings out the pasture","id":"dan Yang menumbuhkan rerumputan,","words":[{"a":"وَٱلَّذِيٓ","en":"And the One Who","id":"And the One Who"},{"a":"أَخۡرَجَ","en":"brings forth","id":"brings forth"},{"a":"ٱلۡمَرۡعَىٰ","en":"the pasture","id":"the pasture"}]},{"n":5,"key":"87:5","arabic":"فَجَعَلَهُۥ غُثَآءً أَحۡوَىٰ","page":591,"juz":30,"en":"And [then] makes it black stubble.","id":"lalu dijadikan-Nya (rumput-rumput) itu kering kehitam-hitaman.","words":[{"a":"فَجَعَلَهُۥ","en":"And then makes it","id":"And then makes it"},{"a":"غُثَآءً","en":"stubble","id":"stubble"},{"a":"أَحۡوَىٰ","en":"dark","id":"dark"}]},{"n":6,"key":"87:6","arabic":"سَنُقۡرِئُكَ فَلَا تَنسَىٰٓ","page":591,"juz":30,"en":"We will make you recite, [O Muḥammad], and you will not forget,","id":"Kami akan membacakan (Alquran) kepadamu (Muhammad) sehingga engkau tidak akan lupa,","words":[{"a":"سَنُقۡرِئُكَ","en":"We will make you recite","id":"We will make you recite"},{"a":"فَلَا","en":"so not","id":"so not"},{"a":"تَنسَىٰٓ","en":"you will forget","id":"you will forget"}]},{"n":7,"key":"87:7","arabic":"إِلَّا مَا شَآءَ ٱللَّهُۚ إِنَّهُۥ يَعۡلَمُ ٱلۡجَهۡرَ وَمَا يَخۡفَىٰ","page":591,"juz":30,"en":"Except what Allāh should will. Indeed, He knows what is declared and what is hidden.","id":"kecuali jika Allah menghendaki. Sungguh, Dia mengetahui yang terang dan yang tersembunyi.","words":[{"a":"إِلَّا","en":"Except","id":"Except"},{"a":"مَا","en":"what","id":"what"},{"a":"شَآءَ","en":"wills","id":"wills"},{"a":"ٱللَّهُۚ","en":"Allah","id":"Allah"},{"a":"إِنَّهُۥ","en":"Indeed, He","id":"Indeed, He"},{"a":"يَعۡلَمُ","en":"knows","id":"knows"},{"a":"ٱلۡجَهۡرَ","en":"the manifest","id":"the manifest"},{"a":"وَمَا","en":"and what","id":"and what"},{"a":"يَخۡفَىٰ","en":"is hidden","id":"is hidden"}]},{"n":8,"key":"87:8","arabic":"وَنُيَسِّرُكَ لِلۡيُسۡرَىٰ","page":591,"juz":30,"en":"And We will ease you toward ease.","id":"Dan Kami akan memudahkan bagimu ke jalan kemudahan (mencapai kebahagian dunia dan akhirat),","words":[{"a":"وَنُيَسِّرُكَ","en":"And We will ease you","id":"And We will ease you"},{"a":"لِلۡيُسۡرَىٰ","en":"to the ease","id":"to the ease"}]},{"n":9,"key":"87:9","arabic":"فَذَكِّرۡ إِن نَّفَعَتِ ٱلذِّكۡرَىٰ","page":591,"juz":30,"en":"So remind, if the reminder should benefit;","id":"oleh sebab itu berikanlah peringatan, karena peringatan itu bermanfaat,","words":[{"a":"فَذَكِّرۡ","en":"So remind","id":"So remind"},{"a":"إِن","en":"if","id":"if"},{"a":"نَّفَعَتِ","en":"benefits","id":"benefits"},{"a":"ٱلذِّكۡرَىٰ","en":"the reminder","id":"the reminder"}]},{"n":10,"key":"87:10","arabic":"سَيَذَّكَّرُ مَن يَخۡشَىٰ","page":591,"juz":30,"en":"He who fears [Allāh] will be reminded.","id":"orang yang takut (kepada Allah) akan mendapat pelajaran,","words":[{"a":"سَيَذَّكَّرُ","en":"He will pay heed ","id":"He will pay heed "},{"a":"مَن","en":"(one) who","id":"(one) who"},{"a":"يَخۡشَىٰ","en":"fears (Allah)","id":"fears (Allah)"}]},{"n":11,"key":"87:11","arabic":"وَيَتَجَنَّبُهَا ٱلۡأَشۡقَى","page":592,"juz":30,"en":"But the wretched one will avoid it","id":"dan orang yang celaka (kafir) akan menjauhinya,","words":[{"a":"وَيَتَجَنَّبُهَا","en":"And will avoid it","id":"And will avoid it"},{"a":"ٱلۡأَشۡقَى","en":"the wretched one","id":"the wretched one"}]},{"n":12,"key":"87:12","arabic":"ٱلَّذِي يَصۡلَى ٱلنَّارَ ٱلۡكُبۡرَىٰ","page":592,"juz":30,"en":"[He] who will [enter and] burn in the greatest Fire,","id":"(yaitu) orang yang akan memasuki api yang besar (neraka),","words":[{"a":"ٱلَّذِي","en":"The one who","id":"The one who"},{"a":"يَصۡلَى","en":"will burn","id":"will burn"},{"a":"ٱلنَّارَ","en":"(in) the Fire","id":"(in) the Fire"},{"a":"ٱلۡكُبۡرَىٰ","en":"[the] great","id":"[the] great"}]},{"n":13,"key":"87:13","arabic":"ثُمَّ لَا يَمُوتُ فِيهَا وَلَا يَحۡيَىٰ","page":592,"juz":30,"en":"Neither dying therein nor living.","id":"selanjutnya dia di sana tidak mati dan tidak (pula) hidup.","words":[{"a":"ثُمَّ","en":"Then","id":"Then"},{"a":"لَا","en":"not","id":"not"},{"a":"يَمُوتُ","en":"he will die","id":"he will die"},{"a":"فِيهَا","en":"therein","id":"therein"},{"a":"وَلَا","en":"and not","id":"and not"},{"a":"يَحۡيَىٰ","en":"will live","id":"will live"}]},{"n":14,"key":"87:14","arabic":"قَدۡ أَفۡلَحَ مَن تَزَكَّىٰ","page":592,"juz":30,"en":"He has certainly succeeded who purifies himself","id":"Sungguh beruntung orang yang menyucikan diri (dengan beriman),","words":[{"a":"قَدۡ","en":"Certainly","id":"Certainly"},{"a":"أَفۡلَحَ","en":"has succeeded","id":"has succeeded"},{"a":"مَن","en":"(one) who","id":"(one) who"},{"a":"تَزَكَّىٰ","en":"purifies (himself)","id":"purifies (himself)"}]},{"n":15,"key":"87:15","arabic":"وَذَكَرَ ٱسۡمَ رَبِّهِۦ فَصَلَّىٰ","page":592,"juz":30,"en":"And mentions the name of his Lord and prays.","id":"dan mengingat nama Tuhannya, lalu dia salat.","words":[{"a":"وَذَكَرَ","en":"And remembers","id":"And remembers"},{"a":"ٱسۡمَ","en":"(the) name","id":"(the) name"},{"a":"رَبِّهِۦ","en":"(of) his Lord","id":"(of) his Lord"},{"a":"فَصَلَّىٰ","en":"and prays","id":"and prays"}]},{"n":16,"key":"87:16","arabic":"بَلۡ تُؤۡثِرُونَ ٱلۡحَيَوٰةَ ٱلدُّنۡيَا","page":592,"juz":30,"en":"But you prefer the worldly life,","id":"Sedangkan kamu (orang-orang kafir) memilih kehidupan dunia,","words":[{"a":"بَلۡ","en":"Nay","id":"Nay"},{"a":"تُؤۡثِرُونَ","en":"You prefer","id":"You prefer"},{"a":"ٱلۡحَيَوٰةَ","en":"the life","id":"the life"},{"a":"ٱلدُّنۡيَا","en":"(of) the world","id":"(of) the world"}]},{"n":17,"key":"87:17","arabic":"وَٱلۡأٓخِرَةُ خَيۡرٞ وَأَبۡقَىٰٓ","page":592,"juz":30,"en":"While the Hereafter is better and more enduring.","id":"padahal kehidupan akhirat itu lebih baik dan lebih kekal.","words":[{"a":"وَٱلۡأٓخِرَةُ","en":"While the Hereafter","id":"While the Hereafter"},{"a":"خَيۡرٞ","en":"(is) better","id":"(is) better"},{"a":"وَأَبۡقَىٰٓ","en":"and everlasting","id":"and everlasting"}]},{"n":18,"key":"87:18","arabic":"إِنَّ هَٰذَا لَفِي ٱلصُّحُفِ ٱلۡأُولَىٰ","page":592,"juz":30,"en":"Indeed, this is in the former scriptures,","id":"Sesungguhnya ini terdapat dalam kitab-kitab yang dahulu,","words":[{"a":"إِنَّ","en":"Indeed","id":"Indeed"},{"a":"هَٰذَا","en":"this","id":"this"},{"a":"لَفِي","en":"surely (is) in","id":"surely (is) in"},{"a":"ٱلصُّحُفِ","en":"the Scriptures","id":"the Scriptures"},{"a":"ٱلۡأُولَىٰ","en":"[the] former","id":"[the] former"}]},{"n":19,"key":"87:19","arabic":"صُحُفِ إِبۡرَٰهِيمَ وَمُوسَىٰ","page":592,"juz":30,"en":"The scriptures of Abraham and Moses.","id":"(yaitu) kitab-kitab Ibrahim dan Musa.","words":[{"a":"صُحُفِ","en":"(The) Scriptures","id":"(The) Scriptures"},{"a":"إِبۡرَٰهِيمَ","en":"(of) Ibrahim","id":"(of) Ibrahim"},{"a":"وَمُوسَىٰ","en":"and Musa","id":"and Musa"}]}]}
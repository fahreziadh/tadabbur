{"surah":1,"verses":[{"n":1,"key":"1:1","arabic":"بِسۡمِ ٱللَّهِ ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","page":1,"juz":1,"en":"In the name of Allāh, the Entirely Merciful, the Especially Merciful.","id":"Dengan nama Allah Yang Maha Pengasih, Maha Penyayang.","words":[{"a":"بِسۡمِ","en":"In (the) name","id":"In (the) name"},{"a":"ٱللَّهِ","en":"(of) Allah","id":"(of) Allah"},{"a":"ٱلرَّحۡمَٰنِ","en":"the Most Gracious","id":"the Most Gracious"},{"a":"ٱلرَّحِيمِ","en":"the Most Merciful","id":"the Most Merciful"}]},{"n":2,"key":"1:2","arabic":"ٱلۡحَمۡدُ لِلَّهِ رَبِّ ٱلۡعَٰلَمِينَ","page":1,"juz":1,"en":"[All] praise is [due] to Allāh, Lord of the worlds -","id":"Segala puji bagi Allah, Tuhan seluruh alam,","words":[{"a":"ٱلۡحَمۡدُ","en":"All praises and thanks","id":"All praises and thanks"},{"a":"لِلَّهِ","en":"(be) to Allah","id":"(be) to Allah"},{"a":"رَبِّ","en":"the Lord","id":"the Lord"},{"a":"ٱلۡعَٰلَمِينَ","en":"of the universe","id":"of the universe"}]},{"n":3,"key":"1:3","arabic":"ٱلرَّحۡمَٰنِ ٱلرَّحِيمِ","page":1,"juz":1,"en":"The Entirely Merciful, the Especially Merciful,","id":"Yang Maha Pengasih, Maha Penyayang,","words":[{"a":"ٱلرَّحۡمَٰنِ","en":"The Most Gracious","id":"The Most Gracious"},{"a":"ٱلرَّحِيمِ","en":"the Most Merciful","id":"the Most Merciful"}]},{"n":4,"key":"1:4","arabic":"مَٰلِكِ يَوۡمِ ٱلدِّينِ","page":1,"juz":1,"en":"Sovereign of the Day of Recompense.","id":"Pemilik hari pembalasan.","words":[{"a":"مَٰلِكِ","en":"(The) Master","id":"(The) Master"},{"a":"يَوۡمِ","en":"(of the) Day","id":"(of the) Day"},{"a":"ٱلدِّينِ","en":"(of the) Judgment","id":"(of the) Judgment"}]},{"n":5,"key":"1:5","arabic":"إِيَّاكَ نَعۡبُدُ وَإِيَّاكَ نَسۡتَعِينُ","page":1,"juz":1,"en":"It is You we worship and You we ask for help.","id":"Hanya kepada Engkaulah kami menyembah dan hanya kepada Engkaulah kami mohon pertolongan.","words":[{"a":"إِيَّاكَ","en":"You Alone","id":"You Alone"},{"a":"نَعۡبُدُ","en":"we worship","id":"we worship"},{"a":"وَإِيَّاكَ","en":"and You Alone","id":"and You Alone"},{"a":"نَسۡتَعِينُ","en":"we ask for help","id":"we ask for help"}]},{"n":6,"key":"1:6","arabic":"ٱهۡدِنَا ٱلصِّرَٰطَ ٱلۡمُسۡتَقِيمَ","page":1,"juz":1,"en":"Guide us to the straight path -","id":"Tunjukilah kami jalan yang lurus,","words":[{"a":"ٱهۡدِنَا","en":"Guide us","id":"Guide us"},{"a":"ٱلصِّرَٰطَ","en":"(to) the path","id":"(to) the path"},{"a":"ٱلۡمُسۡتَقِيمَ","en":"the straight","id":"the straight"}]},{"n":7,"key":"1:7","arabic":"صِرَٰطَ ٱلَّذِينَ أَنۡعَمۡتَ عَلَيۡهِمۡ غَيۡرِ ٱلۡمَغۡضُوبِ عَلَيۡهِمۡ وَلَا ٱلضَّآلِّينَ","page":1,"juz":1,"en":"The path of those upon whom You have bestowed favor, not of those who have earned [Your] anger or of those who are astray.","id":"(yaitu) jalan orang-orang yang telah Engkau beri nikmat kepadanya; bukan (jalan) mereka yang dimurkai, dan bukan (pula jalan) mereka yang sesat.","words":[{"a":"صِرَٰطَ","en":"(The) path","id":"(The) path"},{"a":"ٱلَّذِينَ","en":"(of) those","id":"(of) those"},{"a":"أَنۡعَمۡتَ","en":"You have bestowed (Your) Favors","id":"You have bestowed (Your) Favors"},{"a":"عَلَيۡهِمۡ","en":"on them","id":"on them"},{"a":"غَيۡرِ","en":"not (of)","id":"not (of)"},{"a":"ٱلۡمَغۡضُوبِ","en":"those who earned (Your) wrath","id":"those who earned (Your) wrath"},{"a":"عَلَيۡهِمۡ","en":"on themselves","id":"on themselves"},{"a":"وَلَا","en":"and not","id":"and not"},{"a":"ٱلضَّآلِّينَ","en":"(of) those who go astray","id":"(of) those who go astray"}]}]}
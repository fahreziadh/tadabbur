{"surah":96,"verses":[{"n":1,"key":"96:1","arabic":"ٱقۡرَأۡ بِٱسۡمِ رَبِّكَ ٱلَّذِي خَلَقَ","page":597,"juz":30,"en":"Recite in the name of your Lord who created","id":"Bacalah dengan (menyebut) nama Tuhanmu yang menciptakan,","words":[{"a":"ٱقۡرَأۡ","en":"Read","id":"Read"},{"a":"بِٱسۡمِ","en":"in (the) name","id":"in (the) name"},{"a":"رَبِّكَ","en":"(of) your Lord","id":"(of) your Lord"},{"a":"ٱلَّذِي","en":"the One Who","id":"the One Who"},{"a":"خَلَقَ","en":"created ","id":"created "}]},{"n":2,"key":"96:2","arabic":"خَلَقَ ٱلۡإِنسَٰنَ مِنۡ عَلَقٍ","page":597,"juz":30,"en":"Created man from a clinging substance.","id":"Dia telah menciptakan manusia dari segumpal darah.","words":[{"a":"خَلَقَ","en":"He created","id":"He created"},{"a":"ٱلۡإِنسَٰنَ","en":"man","id":"man"},{"a":"مِنۡ","en":"from","id":"from"},{"a":"عَلَقٍ","en":"a clinging substance","id":"a clinging substance"}]},{"n":3,"key":"96:3","arabic":"ٱقۡرَأۡ وَرَبُّكَ ٱلۡأَكۡرَمُ","page":597,"juz":30,"en":"Recite, and your Lord is the most Generous -","id":"Bacalah, dan Tuhanmulah Yang Mahamulia.","words":[{"a":"ٱقۡرَأۡ","en":"Read","id":"Read"},{"a":"وَرَبُّكَ","en":"and your Lord","id":"and your Lord"},{"a":"ٱلۡأَكۡرَمُ","en":"(is) the Most Generous","id":"(is) the Most Generous"}]},{"n":4,"key":"96:4","arabic":"ٱلَّذِي عَلَّمَ بِٱلۡقَلَمِ","page":597,"juz":30,"en":"Who taught by the pen","id":"Yang mengajar (manusia) dengan pena.","words":[{"a":"ٱلَّذِي","en":"The One Who","id":"The One Who"},{"a":"عَلَّمَ","en":"taught","id":"taught"},{"a":"بِٱلۡقَلَمِ","en":"by the pen","id":"by the pen"}]},{"n":5,"key":"96:5","arabic":"عَلَّمَ ٱلۡإِنسَٰنَ مَا لَمۡ يَعۡلَمۡ","page":597,"juz":30,"en":"Taught man that which he knew not.","id":"Dia mengajarkan manusia apa yang tidak diketahuinya.","words":[{"a":"عَلَّمَ","en":"Taught","id":"Taught"},{"a":"ٱلۡإِنسَٰنَ","en":"man","id":"man"},{"a":"مَا","en":"what","id":"what"},{"a":"لَمۡ","en":"not","id":"not"},{"a":"يَعۡلَمۡ","en":"he knew","id":"he knew"}]},{"n":6,"key":"96:6","arabic":"كـَلَّآ إِنَّ ٱلۡإِنسَٰنَ لَيَطۡغَىٰٓ","page":597,"juz":30,"en":"No! [But] indeed, man transgresses","id":"Sekali-sekali tidak! Sungguh, manusia itu benar-benar melampaui batas,","words":[{"a":"كـَلَّآ","en":"Nay","id":"Nay"},{"a":"إِنَّ","en":"Indeed","id":"Indeed"},{"a":"ٱلۡإِنسَٰنَ","en":"man","id":"man"},{"a":"لَيَطۡغَىٰٓ","en":"surely transgresses","id":"surely transgresses"}]},{"n":7,"key":"96:7","arabic":"أَن رَّءَاهُ ٱسۡتَغۡنَىٰٓ","page":597,"juz":30,"en":"Because he sees himself self-sufficient.","id":"apabila melihat dirinya serba cukup.","words":[{"a":"أَن","en":"That","id":"That"},{"a":"رَّءَاهُ","en":"he sees himself","id":"he sees himself"},{"a":"ٱسۡتَغۡنَىٰٓ","en":"self-sufficient","id":"self-sufficient"}]},{"n":8,"key":"96:8","arabic":"إِنَّ إِلَىٰ رَبِّكَ ٱلرُّجۡعَىٰٓ","page":597,"juz":30,"en":"Indeed, to your Lord is the return.","id":"Sungguh, hanya kepada Tuhanmulah tempat kembali(mu).","words":[{"a":"إِنَّ","en":"Indeed","id":"Indeed"},{"a":"إِلَىٰ","en":"to","id":"to"},{"a":"رَبِّكَ","en":"your Lord","id":"your Lord"},{"a":"ٱلرُّجۡعَىٰٓ","en":"(is) the return","id":"(is) the return"}]},{"n":9,"key":"96:9","arabic":"أَرَءَيۡتَ ٱلَّذِي يَنۡهَىٰ","page":597,"juz":30,"en":"Have you seen the one who forbids","id":"Bagaimana pendapatmu tentang orang yang melarang?","words":[{"a":"أَرَءَيۡتَ","en":"Have you seen","id":"Have you seen"},{"a":"ٱلَّذِي","en":"the one who","id":"the one who"},{"a":"يَنۡهَىٰ","en":"forbids","id":"forbids"}]},{"n":10,"key":"96:10","arabic":"عَبۡدًا إِذَا صَلَّىٰٓ","page":597,"juz":30,"en":"A servant when he prays?","id":"seorang hamba ketika dia melaksanakan salat,","words":[{"a":"عَبۡدًا","en":"A slave","id":"A slave"},{"a":"إِذَا","en":"when","id":"when"},{"a":"صَلَّىٰٓ","en":"he prays","id":"he prays"}]},{"n":11,"key":"96:11","arabic":"أَرَءَيۡتَ إِن كَانَ عَلَى ٱلۡهُدَىٰٓ","page":597,"juz":30,"en":"Have you seen if he is upon guidance","id":"bagaimana pendapatmu jika dia (yang dilarang salat itu) berada di atas kebenaran (petunjuk),","words":[{"a":"أَرَءَيۡتَ","en":"Have you seen","id":"Have you seen"},{"a":"إِن","en":"if","id":"if"},{"a":"كَانَ","en":"he is","id":"he is"},{"a":"عَلَى","en":"upon","id":"upon"},{"a":"ٱلۡهُدَىٰٓ","en":"[the] guidance","id":"[the] guidance"}]},{"n":12,"key":"96:12","arabic":"أَوۡ أَمَرَ بِٱلتَّقۡوَىٰٓ","page":597,"juz":30,"en":"Or enjoins righteousness?","id":"atau dia menyuruh bertakwa (kepada Allah)?","words":[{"a":"أَوۡ","en":"Or","id":"Or"},{"a":"أَمَرَ","en":"he enjoins","id":"he enjoins"},{"a":"بِٱلتَّقۡوَىٰٓ","en":"[of the] righteousness","id":"[of the] righteousness"}]},{"n":13,"key":"96:13","arabic":"أَرَءَيۡتَ إِن كَذَّبَ وَتَوَلَّىٰٓ","page":598,"juz":30,"en":"Have you seen if he denies and turns away -","id":"Bagaimana pendapatmu jika dia (yang melarang) itu mendustakan dan berpaling?","words":[{"a":"أَرَءَيۡتَ","en":"Have you seen","id":"Have you seen"},{"a":"إِن","en":"if","id":"if"},{"a":"كَذَّبَ","en":"he denies","id":"he denies"},{"a":"وَتَوَلَّىٰٓ","en":"and turns away","id":"and turns away"}]},{"n":14,"key":"96:14","arabic":"أَلَمۡ يَعۡلَم بِأَنَّ ٱللَّهَ يَرَىٰ","page":598,"juz":30,"en":"Does he not know that Allāh sees?","id":"Tidakkah dia mengetahui bahwa sesungguhnya Allah melihat (segala perbuatannya)?","words":[{"a":"أَلَمۡ","en":"Does not","id":"Does not"},{"a":"يَعۡلَم","en":"he know","id":"he know"},{"a":"بِأَنَّ","en":"that","id":"that"},{"a":"ٱللَّهَ","en":"Allah","id":"Allah"},{"a":"يَرَىٰ","en":"sees","id":"sees"}]},{"n":15,"key":"96:15","arabic":"كـَلَّا لَئِن لَّمۡ يَنتَهِ لَنَسۡفَعَۢا بِٱلنَّاصِيَةِ","page":598,"juz":30,"en":"No! If he does not desist, We will surely drag him by the forelock","id":"Sekali-kali tidak! Sungguh, jika dia tidak berhenti (berbuat demikian) niscaya Kami tarik ubun-ubunnya (ke dalam neraka),","words":[{"a":"كـَلَّا","en":"Nay","id":"Nay"},{"a":"لَئِن","en":"If","id":"If"},{"a":"لَّمۡ","en":"not","id":"not"},{"a":"يَنتَهِ","en":"he desists","id":"he desists"},{"a":"لَنَسۡفَعَۢا","en":"surely We will drag him","id":"surely We will drag him"},{"a":"بِٱلنَّاصِيَةِ","en":"by the forelock","id":"by the forelock"}]},{"n":16,"key":"96:16","arabic":"نَاصِيَةٖ كَٰذِبَةٍ خَاطِئَةٖ","page":598,"juz":30,"en":"A lying, sinning forelock.","id":"(yaitu) ubun-ubun orang yang mendustakan dan durhaka.","words":[{"a":"نَاصِيَةٖ","en":"A forelock","id":"A forelock"},{"a":"كَٰذِبَةٍ","en":"lying","id":"lying"},{"a":"خَاطِئَةٖ","en":"sinful","id":"sinful"}]},{"n":17,"key":"96:17","arabic":"فَلۡيَدۡعُ نَادِيَهُۥ","page":598,"juz":30,"en":"Then let him call his associates;","id":"Maka biarlah dia memanggil golongannya (untuk menolongnya),","words":[{"a":"فَلۡيَدۡعُ","en":"Then let him call","id":"Then let him call"},{"a":"نَادِيَهُۥ","en":"his associates","id":"his associates"}]},{"n":18,"key":"96:18","arabic":"سَنَدۡعُ ٱلزَّبَانِيَةَ","page":598,"juz":30,"en":"We will call the angels of Hell.","id":"kelak Kami akan memanggil Malaikat Zabaniyah (penyiksa orang-orang yang berdosa)","words":[{"a":"سَنَدۡعُ","en":"We will call","id":"We will call"},{"a":"ٱلزَّبَانِيَةَ","en":"the Angels of Hell","id":"the Angels of Hell"}]},{"n":19,"key":"96:19","arabic":"كـَلَّا لَا تُطِعۡهُ وَٱسۡجُدۡۤ وَٱقۡتَرِب۩","page":598,"juz":30,"en":"No! Do not obey him. But prostrate and draw near [to Allāh].","id":"sekali-kali tidak! Janganlah kamu patuh kepadanya; dan sujudlah serta dekatkanlah (dirimu kepada Allah).","words":[{"a":"كـَلَّا","en":"Nay","id":"Nay"},{"a":"لَا","en":"(Do) not","id":"(Do) not"},{"a":"تُطِعۡهُ","en":"obey him","id":"obey him"},{"a":"وَٱسۡجُدۡۤ","en":"But prostrate","id":"But prostrate"},{"a":"وَٱقۡتَرِب۩","en":"and draw near (to Allah)","id":"and draw near (to Allah)"}]}]}
{"surah":109,"verses":[{"n":1,"key":"109:1","arabic":"قُلۡ يَٰٓأَيُّهَا ٱلۡكَٰفِرُونَ","page":603,"juz":30,"en":"Say, \"O disbelievers,","id":"Katakanlah (Muhammad), \"Wahai orang-orang kafir!","words":[{"a":"قُلۡ","en":"Say","id":"Say"},{"a":"يَٰٓأَيُّهَا","en":"O","id":"O"},{"a":"ٱلۡكَٰفِرُونَ","en":"disbelievers","id":"disbelievers"}]},{"n":2,"key":"109:2","arabic":"لَآ أَعۡبُدُ مَا تَعۡبُدُونَ","page":603,"juz":30,"en":"I do not worship what you worship.","id":"aku tidak akan menyembah apa yang kamu sembah,","words":[{"a":"لَآ","en":"Not","id":"Not"},{"a":"أَعۡبُدُ","en":"I worship","id":"I worship"},{"a":"مَا","en":"what","id":"what"},{"a":"تَعۡبُدُونَ","en":"you worship","id":"you worship"}]},{"n":3,"key":"109:3","arabic":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","page":603,"juz":30,"en":"Nor are you worshippers of what I worship.","id":"dan kamu bukan penyembah apa yang aku sembah,","words":[{"a":"وَلَآ","en":"And not","id":"And not"},{"a":"أَنتُمۡ","en":"you","id":"you"},{"a":"عَٰبِدُونَ","en":"(are) worshippers","id":"(are) worshippers"},{"a":"مَآ","en":"(of) what","id":"(of) what"},{"a":"أَعۡبُدُ","en":"I worship","id":"I worship"}]},{"n":4,"key":"109:4","arabic":"وَلَآ أَنَا۠ عَابِدٞ مَّا عَبَدتُّمۡ","page":603,"juz":30,"en":"Nor will I be a worshipper of what you worship.","id":"dan aku tidak pernah menjadi penyembah apa yang kamu sembah,","words":[{"a":"وَلَآ","en":"And not","id":"And not"},{"a":"أَنَا۠","en":"I am","id":"I am"},{"a":"عَابِدٞ","en":"a worshipper","id":"a worshipper"},{"a":"مَّا","en":"(of) what","id":"(of) what"},{"a":"عَبَدتُّمۡ","en":"you worship","id":"you worship"}]},{"n":5,"key":"109:5","arabic":"وَلَآ أَنتُمۡ عَٰبِدُونَ مَآ أَعۡبُدُ","page":603,"juz":30,"en":"Nor will you be worshippers of what I worship.","id":"dan kamu tidak pernah (pula) menjadi penyembah apa yang aku sembah.","words":[{"a":"وَلَآ","en":"And not","id":"And not"},{"a":"أَنتُمۡ","en":"you","id":"you"},{"a":"عَٰبِدُونَ","en":"(are) worshippers","id":"(are) worshippers"},{"a":"مَآ","en":"(of) what","id":"(of) what"},{"a":"أَعۡبُدُ","en":"I worship","id":"I worship"}]},{"n":6,"key":"109:6","arabic":"لَكُمۡ دِينُكُمۡ وَلِيَ دِينِ","page":603,"juz":30,"en":"For you is your religion, and for me is my religion.\"","id":"Untukmu agamamu, dan untukku agamaku.\"","words":[{"a":"لَكُمۡ","en":"For you","id":"For you"},{"a":"دِينُكُمۡ","en":"(is) your religion","id":"(is) your religion"},{"a":"وَلِيَ","en":"and for me","id":"and for me"},{"a":"دِينِ","en":"(is) my religion","id":"(is) my religion"}]}]}
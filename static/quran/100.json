{"surah":100,"verses":[{"n":1,"key":"100:1","arabic":"وَٱلۡعَٰدِيَٰتِ ضَبۡحٗا","page":599,"juz":30,"en":"By the racers, panting,","id":"Demi kuda perang yang berlari kencang terengah-engah,","words":[{"a":"وَٱلۡعَٰدِيَٰتِ","en":"By the racers","id":"By the racers"},{"a":"ضَبۡحٗا","en":"panting","id":"panting"}]},{"n":2,"key":"100:2","arabic":"فَٱلۡمُورِيَٰتِ قَدۡحٗا","page":599,"juz":30,"en":"And the producers of sparks [when] striking","id":"dan kuda yang memercikkan bunga api (dengan pukulan kuku kakinya),","words":[{"a":"فَٱلۡمُورِيَٰتِ","en":"And the producers of sparks","id":"And the producers of sparks"},{"a":"قَدۡحٗا","en":"striking","id":"striking"}]},{"n":3,"key":"100:3","arabic":"فَٱلۡمُغِيرَٰتِ صُبۡحٗا","page":599,"juz":30,"en":"And the chargers at dawn,","id":"dan kuda yang menyerang (dengan tiba-tiba) pada waktu pagi,","words":[{"a":"فَٱلۡمُغِيرَٰتِ","en":"And the chargers","id":"And the chargers"},{"a":"صُبۡحٗا","en":"(at) dawn","id":"(at) dawn"}]},{"n":4,"key":"100:4","arabic":"فَأَثَرۡنَ بِهِۦ نَقۡعٗا","page":599,"juz":30,"en":"Stirring up thereby [clouds of] dust,","id":"sehingga menerbangkan debu,","words":[{"a":"فَأَثَرۡنَ","en":"Then raise","id":"Then raise"},{"a":"بِهِۦ","en":"thereby","id":"thereby"},{"a":"نَقۡعٗا","en":"dust","id":"dust"}]},{"n":5,"key":"100:5","arabic":"فَوَسَطۡنَ بِهِۦ جَمۡعًا","page":599,"juz":30,"en":"Arriving thereby in the center collectively,","id":"lalu menyerbu ke tengah-tengah kumpulan musuh,","words":[{"a":"فَوَسَطۡنَ","en":"Then penetrate (in the) center","id":"Then penetrate (in the) center"},{"a":"بِهِۦ","en":"thereby","id":"thereby"},{"a":"جَمۡعًا","en":"collectively","id":"collectively"}]},{"n":6,"key":"100:6","arabic":"إِنَّ ٱلۡإِنسَٰنَ لِرَبِّهِۦ لَكَنُودٞ","page":600,"juz":30,"en":"Indeed mankind, to his Lord, is ungrateful.","id":"sungguh, manusia itu sangat ingkar, (tidak bersyukur) kepada Tuhannya,","words":[{"a":"إِنَّ","en":"Indeed","id":"Indeed"},{"a":"ٱلۡإِنسَٰنَ","en":"mankind","id":"mankind"},{"a":"